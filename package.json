{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @game/client dev",
    "preview": "bun run --filter @game/client preview",
    "build": "bun run --filter @game/client build",
    "deploy": "bun run spacetime:publish && alchemy deploy",
    "module:publish": "bun run spacetime:publish:local",
    "spacetime:publish:local": "spacetime publish --module-path packages/module --server local --yes",
    "spacetime:publish": "spacetime publish --module-path packages/module --server maincloud --yes",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:text": "textlint \"**/*.md\"",
    "lint:text:fix": "textlint --fix \"**/*.md\"",
    "lint:pr": "textlint --stdin --stdin-filename pr.md",
    "ci": "bun run fmt:check && bun run lint && bun run lint:text && fallow && bun run build",
    "test": "bun test packages/sim"
  },
  "dependencies": {
    "alchemy": "next",
    "effect": "4.0.0-beta.105"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.105",
    "@effect/platform-node": "4.0.0-beta.105",
    "fallow": "^3.16.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-ja-space-around-code": "^3.0.3",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.3"
  }
}
