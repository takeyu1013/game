{
  "private": true,
  "workspaces": [
    "spacetimedb"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "bun run spacetime:publish && alchemy deploy",
    "spacetime:generate": "spacetime generate",
    "spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local && bun run spacetime:generate",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud --yes --delete-data=on-conflict",
    "fmt": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:text": "textlint \"**/*.md\"",
    "lint:text:fix": "textlint --fix \"**/*.md\"",
    "lint:pr": "textlint --stdin --stdin-filename pr.md",
    "postinstall": "bun install --cwd tooling/eslint-plugin-functional --frozen-lockfile",
    "ci": "bun run fmt:check && bun run lint && bun run lint:text && fallow && bun run build"
  },
  "dependencies": {
    "konva": "^10.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.2.5",
    "spacetimedb": "2.8.*"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.105",
    "@effect/platform-node": "4.0.0-beta.105",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "alchemy": "next",
    "effect": "4.0.0-beta.105",
    "fallow": "^3.16.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-plugin-eslint": "^1.78.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-ja-space-around-code": "^3.0.3",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.5"
  }
}
