{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @game/client dev",
    "preview": "bun run --filter @game/client preview",
    "deploy": "alchemy deploy",
    "module:publish": "spacetime publish --server local --yes game",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:text": "textlint \"**/*.md\"",
    "lint:text:fix": "textlint --fix \"**/*.md\"",
    "test": "bun test packages/sim"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-beta.105",
    "@effect/platform-node": "4.0.0-beta.105",
    "alchemy": "next",
    "effect": "4.0.0-beta.105",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-ja-space-around-code": "^3.0.3",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.3"
  }
}
