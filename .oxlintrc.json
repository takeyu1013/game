{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/module-bindings"],
  "jsPlugins": [{ "name": "eslint-js", "specifier": "oxlint-plugin-eslint" }],
  "rules": {
    "max-classes-per-file": ["error", 0],
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "eslint-js/no-restricted-syntax": [
      "error",
      "ForStatement",
      "ForInStatement",
      "ForOfStatement",
      "ThrowStatement",
      {
        "selector": "VariableDeclaration[kind='const'] > VariableDeclarator[init.type=/Literal|ObjectExpression|ArrayExpression/]",
        "message": "定数にはas constが必要です"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "useEffectの使用は禁止です"
          },
          {
            "name": "react",
            "importNames": ["default"],
            "message": "React.によるアクセスは禁止です"
          }
        ]
      }
    ]
  }
}
