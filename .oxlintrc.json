{
  "ignorePatterns": ["src/module-bindings"],
  "jsPlugins": [{ "name": "eslint-js", "specifier": "oxlint-plugin-eslint" }],
  "rules": {
    "max-classes-per-file": ["error", 0],
    "eslint-js/no-restricted-syntax": [
      "error",
      "ForStatement",
      "ForInStatement",
      "ForOfStatement",
      "ThrowStatement"
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "useEffectの使用は禁止です"
          },
          {
            "name": "react",
            "importNames": ["default"],
            "message": "React.によるアクセスは禁止です"
          }
        ]
      }
    ]
  }
}
