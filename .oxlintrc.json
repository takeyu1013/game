{
  "ignorePatterns": ["src/module-bindings"],
  "jsPlugins": [{ "name": "eslint-js", "specifier": "oxlint-plugin-eslint" }],
  "rules": {
    "max-classes-per-file": ["error", 0],
    "eslint-js/no-restricted-syntax": [
      "error",
      "ForStatement",
      "ForInStatement",
      "ForOfStatement",
      "ThrowStatement",
      {
        "selector": "TSAsExpression[typeAnnotation.typeName.name!='const']",
        "message": "asによる型アサーションは禁止です"
      },
      {
        "selector": "VariableDeclaration[kind='const'] > VariableDeclarator:matches([init.type='Literal'], [init.type='ObjectExpression'], [init.type='ArrayExpression'], [init.type='TemplateLiteral'][init.expressions.length=0], [init.type='UnaryExpression'][init.argument.type='Literal'])",
        "message": "定数にはas constが必要です"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "useEffectの使用は禁止です"
          },
          {
            "name": "react",
            "importNames": ["default"],
            "message": "React.によるアクセスは禁止です"
          }
        ]
      }
    ]
  }
}
