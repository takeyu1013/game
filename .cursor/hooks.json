{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bun run hook:edit </dev/null",
        "timeout": 60
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bun run hook:pr </dev/null; echo '{\"permission\":\"allow\"}'",
        "matcher": "gh\\s+pr\\s+create",
        "timeout": 120
      }
    ]
  }
}
