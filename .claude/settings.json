{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bunx oxfmt@latest </dev/null",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "bunx oxfmt@latest </dev/null; bunx oxlint@latest --fix </dev/null; bunx fallow audit",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bunx fallow audit",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bunx fallow audit",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
